<Window x:Class="SpectrumViewerRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectrumViewerRT"
        mc:Ignorable="d"
        Title="Spectrum Viewer RT" Height="720" Width="1180" MinHeight="600" MinWidth="980"
        Background="#111418" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D2833"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5B748E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0A0F14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#65717D"/>
                                <Setter TargetName="Border" Property="Background" Value="#151A20"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#29313A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,16,0"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#33414F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#111820"
                                                BorderBrush="#33414F"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <ContentPresenter Margin="8,0,28,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.Foreground="#E6EDF3"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Fill="#9FB0C1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1D2833"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#5B748E"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#172331"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#5B748E"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Border" Property="Background" Value="#151A20"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#29313A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  TextElement.Foreground="#E6EDF3"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#111820"
                                        BorderBrush="#33414F"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#65717D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#26333F" BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D2833"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#24364A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#5D8E90"/>
            <Setter Property="Background" Value="#252B31"/>
            <Setter Property="BorderBrush" Value="#3C4650"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}"
                                                  Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="14" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#69727A"
                                                        BorderBrush="#303842"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                    <Border Margin="4,3"
                                                            Background="#CED5DB"
                                                            CornerRadius="1"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#7B858E"/>
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#48525C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#87919A"/>
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#5C6872"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#4A525A"/>
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#5C6670"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{TemplateBinding Background}"
                                                  Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#6FA5A7"/>
                                <Setter Property="Background" Value="#303841"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A555F"/>
                                <Setter Property="Background" Value="#20252B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" LastChildFill="True" Background="Transparent">
        <DockPanel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Show recording / playback" InputGestureText="Ctrl+1" x:Name="ContextTransportMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Show settings" InputGestureText="Ctrl+2" x:Name="ContextSettingsMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Show main display" InputGestureText="Ctrl+3" x:Name="ContextMainDisplayMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Show waveform" InputGestureText="Ctrl+4" x:Name="ContextWaveformMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Show level meter" InputGestureText="Ctrl+5" x:Name="ContextLevelMeterMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Compact mode" InputGestureText="Ctrl+T" x:Name="ContextCompactMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Display Mode" InputGestureText="Ctrl+D">
                    <MenuItem Header="Spectrogram" x:Name="ContextDisplaySpectrogramMenuItem"
                              IsCheckable="True" Click="DisplayModeContextMenuItem_Click"/>
                    <MenuItem Header="Spectrogram (Stereo)" x:Name="ContextDisplaySpectrogramStereoMenuItem"
                              IsCheckable="True" Click="DisplayModeContextMenuItem_Click"/>
                    <MenuItem Header="Spectrum Analyzer (Mono)" x:Name="ContextDisplayAnalyzerMonoMenuItem"
                              IsCheckable="True" Click="DisplayModeContextMenuItem_Click"/>
                    <MenuItem Header="Spectrum Analyzer (Stereo)" x:Name="ContextDisplayAnalyzerStereoMenuItem"
                              IsCheckable="True" Click="DisplayModeContextMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Stereo Split">
                    <MenuItem Header="Left / Right" x:Name="ContextStereoSplitLeftRightMenuItem"
                              IsCheckable="True" Click="StereoSplitContextMenuItem_Click"/>
                    <MenuItem Header="Top / Bottom" x:Name="ContextStereoSplitTopBottomMenuItem"
                              IsCheckable="True" Click="StereoSplitContextMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="LIVE TIME display" InputGestureText="Ctrl+L">
                    <MenuItem Header="Dot matrix" x:Name="ContextStatusDotMenuItem" IsCheckable="True" Click="StatusDisplayStyleMenuItem_Click"/>
                    <MenuItem Header="16 segment" x:Name="ContextStatusSegmentMenuItem" IsCheckable="True" Click="StatusDisplayStyleMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Color" InputGestureText="Ctrl+F">
                    <MenuItem Header="Cyan" Tag="0" x:Name="ContextColorCyanMenuItem" IsCheckable="True" Click="MeterColorContextMenuItem_Click"/>
                    <MenuItem Header="Green" Tag="1" x:Name="ContextColorGreenMenuItem" IsCheckable="True" Click="MeterColorContextMenuItem_Click"/>
                    <MenuItem Header="Amber" Tag="2" x:Name="ContextColorAmberMenuItem" IsCheckable="True" Click="MeterColorContextMenuItem_Click"/>
                    <MenuItem Header="Blue" Tag="3" x:Name="ContextColorBlueMenuItem" IsCheckable="True" Click="MeterColorContextMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Meter" InputGestureText="Ctrl+M">
                    <MenuItem Header="Block" Tag="0" x:Name="ContextMeterBlockMenuItem" IsCheckable="True" Click="MeterStyleContextMenuItem_Click"/>
                    <MenuItem Header="Fine Lines" Tag="1" x:Name="ContextMeterFineLineMenuItem" IsCheckable="True" Click="MeterStyleContextMenuItem_Click"/>
                    <MenuItem Header="Dot Matrix Block" Tag="2" x:Name="ContextMeterDotBlockMenuItem" IsCheckable="True" Click="MeterStyleContextMenuItem_Click"/>
                    <MenuItem Header="Dot Matrix Fine Lines" Tag="3" x:Name="ContextMeterDotFineLineMenuItem" IsCheckable="True" Click="MeterStyleContextMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="Always on top" x:Name="ContextAlwaysOnTopMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Show all panels" Click="ShowAllPanelsMenuItem_Click"/>
                <MenuItem Header="Reset layout" Click="ResetLayoutMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
            </ContextMenu>
        </DockPanel.ContextMenu>

        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Height="26" Visibility="Collapsed"
              Background="#151A20" Foreground="#E6EDF3">
            <MenuItem Header="_View">
                <MenuItem Header="Recording / playback" x:Name="TransportMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Settings" x:Name="SettingsMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Main display" x:Name="MainDisplayMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Waveform" x:Name="WaveformMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="Level meter" x:Name="LevelMeterMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Compact mode" x:Name="CompactMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
                <MenuItem Header="LIVE TIME display">
                    <MenuItem Header="Dot matrix" x:Name="StatusDotMenuItem" IsCheckable="True" Click="StatusDisplayStyleMenuItem_Click"/>
                    <MenuItem Header="16 segment" x:Name="StatusSegmentMenuItem" IsCheckable="True" Click="StatusDisplayStyleMenuItem_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show all panels" Click="ShowAllPanelsMenuItem_Click"/>
                <MenuItem Header="Reset layout" Click="ResetLayoutMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="Always on top" x:Name="AlwaysOnTopMenuItem" IsCheckable="True" Click="LayoutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border x:Name="TopPanel" DockPanel.Dock="Top" Background="#1B2027" BorderBrush="#2D3540" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="TransportPrimaryPanel" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ModeCombo" Grid.Column="1" SelectionChanged="ModeCombo_SelectionChanged"/>
                    <TextBlock Grid.Column="2" Text="Device" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Left" MinWidth="270" DisplayMemberPath="Name"
                                  SelectionChanged="DeviceCombo_SelectionChanged"/>
                        <CheckBox x:Name="CompensateSystemVolumeCheck" Content="Ignore System Volume"
                                  Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                  Foreground="#E6EDF3"
                                  Checked="CompensateSystemVolumeCheck_Changed"
                                  Unchecked="CompensateSystemVolumeCheck_Changed"
                                  ToolTip="Compensate Windows output-volume attenuation so System Output is captured and displayed near its 100% volume level. Muted or 0% audio cannot be restored."/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="StartButton" Click="StartButton_Click">
                            <Grid Width="64" Height="22">
                                <Ellipse x:Name="RecordLed" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Fill="#361010" Stroke="#5A1B1B" StrokeThickness="1"/>
                                <TextBlock Text="Record" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
                        <Button x:Name="PlayButton" Click="PlayButton_Click" IsEnabled="False">
                            <Grid Width="64" Height="22">
                                <Ellipse x:Name="PlayLed" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Fill="#0F2C18" Stroke="#1C4F2B" StrokeThickness="1"/>
                                <TextBlock Text="Play" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SaveButton" Content="Save WAV" Click="SaveButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="TransportSecondaryPanel" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="MonitorCheck" Content="Monitor" Foreground="#E6EDF3" VerticalAlignment="Center" Margin="0,0,18,0"
                              Visibility="Collapsed"
                              Checked="MonitorCheck_Changed" Unchecked="MonitorCheck_Changed"
                              ToolTip="Starts live display without recording."/>
                    <StackPanel x:Name="SettingsVisualOptionsPanel" Orientation="Horizontal">
                        <TextBlock Text="Status" Foreground="#65717D" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#9FB0C1" MinWidth="260"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Rec Level"/>
                        <Slider x:Name="RecordGainSlider" Width="130" Minimum="-24" Maximum="12" Value="0" TickFrequency="3" Margin="8,0,6,0"
                                ValueChanged="ControlValue_Changed"
                                MouseDoubleClick="RecordGainSlider_MouseDoubleClick"
                                ToolTip="Recording gain applied to saved audio and live input displays."/>
                        <TextBlock x:Name="RecordGainValueText" Text="0.0 dB" MinWidth="54" Foreground="#9FB0C1" Margin="0,0,20,0"/>
                        <TextBlock Text="Playback"/>
                        <Slider x:Name="PlaybackSlider" Width="360" Minimum="0" Maximum="0" Value="0" Margin="8,0,8,0"
                                IsMoveToPointEnabled="True"
                                ValueChanged="PlaybackSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="PlaybackSlider_SeekCommitted"
                                ToolTip="Playback position. Drag or click to seek."/>
                        <TextBlock x:Name="PlaybackPositionText" Text="00:00 / 00:00" Foreground="#9FB0C1" MinWidth="94"/>
                    </StackPanel>
                </Grid>

                <DockPanel x:Name="SettingsDisplayPanel" Grid.Row="2" Grid.ColumnSpan="5" Margin="0,10,0,0" LastChildFill="True">
                    <Button x:Name="DefaultsButton" Content="Default Settings"
                            DockPanel.Dock="Right"
                            Click="DefaultsButton_Click"
                            Margin="12,0,0,0"
                            ToolTip="Restore display, meter, grid, and window settings to defaults."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Display"/>
                        <ComboBox x:Name="DisplayModeCombo" Width="210" MinWidth="210" Margin="8,0,14,0" SelectionChanged="DisplayModeCombo_SelectionChanged"/>
                        <Button x:Name="AnalyzerBandsButton" Content="Bands: 48" MinWidth="86" Height="32"
                                Margin="0,0,14,0" Click="AnalyzerBandsButton_Click"
                                ToolTip="Set the spectrum analyzer frequency-band count independently for Mono and Stereo.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="5 bands" Tag="5" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="7 bands" Tag="7" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="9 bands" Tag="9" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="10 bands" Tag="10" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="12 bands" Tag="12" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="14 bands" Tag="14" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="18 bands" Tag="18" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="27 bands" Tag="27" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <MenuItem Header="48 bands (default)" Tag="48" IsCheckable="True" Click="AnalyzerBandPresetMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="User Custom" x:Name="AnalyzerBandCustomMenuItem"
                                              IsCheckable="True" Click="AnalyzerBandCustomMenuItem_Click"/>
                                    <MenuItem Header="Detailed settings..." Click="AnalyzerBandDetailsMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FpsButton" Content="FPS: 60" MinWidth="78" Height="32" Margin="0,0,14,0"
                                Click="FpsButton_Click"
                                ToolTip="Choose a render-rate preset or open detailed FPS adjustment.">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="15 FPS" Tag="15" Click="FpsPresetMenuItem_Click"/>
                                    <MenuItem Header="30 FPS" Tag="30" Click="FpsPresetMenuItem_Click"/>
                                    <MenuItem Header="60 FPS" Tag="60" Click="FpsPresetMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Detailed settings..." Click="FpsDetailsMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Popup x:Name="FpsDetailPopup" PlacementTarget="{Binding ElementName=FpsButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#111820" BorderBrush="#5B748E" BorderThickness="1"
                                    CornerRadius="3" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Render FPS" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="FpsSlider" Width="180" Minimum="12" Maximum="60" Value="60"
                                                TickFrequency="1" IsMoveToPointEnabled="True" Margin="0,0,10,0"
                                                ValueChanged="ControlValue_Changed"
                                                MouseDoubleClick="FpsSlider_MouseDoubleClick"
                                                ToolTip="Render update rate. Higher FPS makes movement smoother but does not change the time scale."/>
                                        <TextBox x:Name="FpsTextBox" Width="52" Height="28"
                                                 Foreground="#E6EDF3" Background="#0A0F14"
                                                 BorderBrush="#33414F" BorderThickness="1"
                                                 TextAlignment="Right" VerticalContentAlignment="Center"
                                                 Padding="4,0" LostFocus="FpsTextBox_LostFocus"
                                                 KeyDown="FpsTextBox_KeyDown"/>
                                    </StackPanel>
                                    <TextBlock Text="12-60 FPS" Foreground="#7F91A3" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <TextBlock Text="Color"/>
                        <ComboBox x:Name="MeterColorCombo" Width="96" MinWidth="96" Margin="8,0,14,0" SelectionChanged="MeterSetting_Changed"/>
                        <TextBlock Text="Meter"/>
                        <ComboBox x:Name="MeterStyleCombo" Width="150" MinWidth="150" Margin="8,0,14,0" SelectionChanged="MeterSetting_Changed"/>
                        <CheckBox x:Name="VuNormalizeCheck" Content="VU" IsChecked="False" Foreground="#E6EDF3" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Checked="MeterVisualSetting_Changed" Unchecked="MeterVisualSetting_Changed"
                                  ToolTip="Boost meter and analyzer display only, so nominal levels touch 0 dB/red like an analog deck."/>
                        <CheckBox x:Name="ShowUnlitCheck" Content="Dim" IsChecked="True" Foreground="#E6EDF3" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Checked="MeterVisualSetting_Changed" Unchecked="MeterVisualSetting_Changed"
                                  ToolTip="Shows inactive VFD segments very faintly."/>
                        <CheckBox x:Name="GlowCheck" Content="Glow" IsChecked="True" Foreground="#E6EDF3" VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Checked="MeterVisualSetting_Changed" Unchecked="MeterVisualSetting_Changed"
                                  ToolTip="Adds a soft glow around active VFD segments."/>
                        <CheckBox x:Name="TextureCheck" Content="Texture" IsChecked="True" Foreground="#E6EDF3" VerticalAlignment="Center"
                                  Checked="MeterVisualSetting_Changed" Unchecked="MeterVisualSetting_Changed"
                                  ToolTip="Overlays subtle VFD glass and scanline texture."/>
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="SettingsPrimaryPanel" Grid.Row="3" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Gain"/>
                    <Slider x:Name="GainSlider" Width="118" Minimum="0.2" Maximum="8" Value="2.4" TickFrequency="0.2" Margin="8,0,6,0"
                            ValueChanged="ControlValue_Changed"
                            MouseDoubleClick="GainSlider_MouseDoubleClick"
                            ToolTip="FFT input gain multiplier. It changes spectrogram brightness only, not audio volume."/>
                    <TextBlock x:Name="GainValueText" Text="x2.4" MinWidth="36" Foreground="#9FB0C1" Margin="0,0,14,0"/>
                    <TextBlock Text="Range"/>
                    <Slider x:Name="RangeSlider" Width="130" Minimum="45" Maximum="120" Value="85" TickFrequency="5" Margin="8,0,18,0"
                            ValueChanged="DisplaySetting_Changed"
                            MouseDoubleClick="RangeSlider_MouseDoubleClick"
                            ToolTip="Spectrogram dynamic range in dB. Lower values make quiet details brighter; higher values preserve more level contrast."/>
                    <TextBlock x:Name="RangeValueText" Text="85 dB" MinWidth="42" Foreground="#9FB0C1" Margin="-12,0,14,0"/>
                    <TextBlock Text="Scale"/>
                    <ComboBox x:Name="ScaleCombo" Width="90" MinWidth="90" Margin="8,0,18,0" SelectionChanged="DisplaySetting_Changed" MouseDoubleClick="ScaleCombo_MouseDoubleClick"/>
                </StackPanel>

                <StackPanel x:Name="SettingsSecondaryPanel" Grid.Row="4" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Max Hz"/>
                    <ComboBox x:Name="MaxFrequencyCombo" Width="100" MinWidth="100" Margin="8,0,18,0" SelectionChanged="DisplaySetting_Changed" MouseDoubleClick="MaxFrequencyCombo_MouseDoubleClick"/>
                    <CheckBox x:Name="GridCheck" Content="Grid" IsChecked="True" Foreground="#E6EDF3" VerticalAlignment="Center"
                              Margin="0,0,18,0" Checked="GridSetting_Changed" Unchecked="GridSetting_Changed"/>
                    <TextBlock Text="Grid Time/div"/>
                    <Slider x:Name="TimeDivisionSlider" Width="150" Minimum="0.25" Maximum="5" Value="1" TickFrequency="0.25"
                            Margin="8,0,8,0" ValueChanged="GridSetting_Changed"
                            MouseDoubleClick="TimeDivisionSlider_MouseDoubleClick"
                            ToolTip="Seconds per horizontal division. This controls the time scale of the spectrogram and waveform."/>
                    <TextBlock x:Name="TimeDivisionText" Text="1.00 s"/>
                    <TextBlock Text="Visible"/>
                    <TextBlock x:Name="VisibleTimeText" Text="37.5 s" Foreground="#9FB0C1" Margin="8,0,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Margin="14" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="112"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <Border x:Name="MainDisplayPanel" BorderBrush="#2D3540" BorderThickness="1" Background="#07090C">
                <Grid>
                    <Image x:Name="SpectrogramImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="SpectrogramGridCanvas" IsHitTestVisible="False" SizeChanged="GridCanvas_SizeChanged"/>
                    <local:SpectrumAnalyzerDisplay x:Name="SpectrumAnalyzer" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="TimeAxisPanel" Grid.Row="1" Margin="0,0,0,0" Background="#10161D" BorderBrush="#2D3540" BorderThickness="1,0,1,1">
                <Canvas x:Name="TimeAxisCanvas" IsHitTestVisible="False" SizeChanged="GridCanvas_SizeChanged"/>
            </Border>

            <Border x:Name="WaveformPanel" Grid.Row="2" Margin="0,12,0,0" BorderBrush="#2D3540" BorderThickness="1" Background="#07090C">
                <Grid>
                    <Image x:Name="WaveformImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="WaveformGridCanvas" IsHitTestVisible="False" SizeChanged="GridCanvas_SizeChanged"/>
                    <TextBlock Text="Waveform" Foreground="#8DA0B3" Margin="10,8,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border x:Name="LevelMeterPanel" Grid.Row="3" Margin="0,12,0,0" Background="#1B2027"
                    BorderBrush="#2D3540" BorderThickness="1" Padding="12" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LevelMeterColumn" Width="*"/>
                        <ColumnDefinition x:Name="VfdStatusColumn" Width="190"/>
                    </Grid.ColumnDefinitions>
                    <local:VfdLevelMeter x:Name="LevelMeter" VerticalAlignment="Stretch"/>
                    <local:VfdStatusDisplay x:Name="VfdStatus" Grid.Column="1" Margin="8,0,0,0"
                                            VerticalAlignment="Stretch" Cursor="Hand"
                                            PreviewMouseLeftButtonDown="VfdStatus_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="VfdStatus_PreviewMouseMove"
                                            MouseLeftButtonUp="VfdStatus_MouseLeftButtonUp"
                                            ToolTip="Click during LIVE monitoring to toggle elapsed time and clock display."/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
