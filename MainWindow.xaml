<Window x:Class="SpectrumViewerRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Spectrum Viewer RT" Height="720" Width="1120" MinHeight="560" MinWidth="860"
        Background="#111418">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Margin" Value="8,0,16,0"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#1B2027" BorderBrush="#2D3540" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Input" FontWeight="SemiBold"/>
                <ComboBox x:Name="DeviceCombo" Grid.Column="1" HorizontalAlignment="Left" DisplayMemberPath="Name"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="更新" Click="RefreshButton_Click"/>
                    <Button x:Name="StartButton" Content="開始" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False"/>
                    <Button x:Name="PlayButton" Content="再生" Click="PlayButton_Click" IsEnabled="False"/>
                    <Button x:Name="SaveButton" Content="WAV保存" Click="SaveButton_Click" IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="MonitorCheck" Content="モニター" Foreground="#E6EDF3" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="Gain"/>
                    <Slider x:Name="GainSlider" Width="130" Minimum="0.2" Maximum="8" Value="2.4" TickFrequency="0.2" Margin="8,0,18,0"/>
                    <TextBlock Text="Range"/>
                    <Slider x:Name="RangeSlider" Width="130" Minimum="45" Maximum="120" Value="85" TickFrequency="5" Margin="8,0,18,0"/>
                    <TextBlock Text="FPS"/>
                    <Slider x:Name="FpsSlider" Width="120" Minimum="12" Maximum="60" Value="32" TickFrequency="4" Margin="8,0,18,0"/>
                    <TextBlock x:Name="StatusText" Text="準備完了" Foreground="#9FB0C1"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="#2D3540" BorderThickness="1" Background="#07090C">
                <Grid>
                    <Image x:Name="SpectrogramImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                    <TextBlock Text="20 Hz" Foreground="#8DA0B3" Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                    <TextBlock Text="24 kHz" Foreground="#8DA0B3" Margin="10,8,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,12,0,0" Background="#1B2027" BorderBrush="#2D3540" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Height="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PeakText" Grid.Column="1" Text="Peak: -inf dB" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="録音: 00:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FormatText" Grid.Column="3" Text="48 kHz / mono" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
